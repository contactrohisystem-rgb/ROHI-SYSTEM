# ROHI SYSTEMS — environment variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Database (SQLite, local dev) ---
DATABASE_URL="file:./db/custom.db"

# --- AI Chatbot (OpenRouter) ---
# Get a FREE API key at https://openrouter.ai/keys (sign in with Google/GitHub)
# Free models are available — no payment needed.
OPENROUTER_API_KEY="sk-or-v1-your-key-here"
# Optional: override the model (defaults to nvidia/nemotron-3.5-super-vl:free)
# Browse models at https://openrouter.ai/models (filter for "free")
# OPENROUTER_MODEL="nvidia/nemotron-3.5-super-vl:free"

# --- Email notifications (Resend) ---
# Get a free API key at https://resend.com (100 emails/day free)
RESEND_API_KEY=""
# The email address to receive contact-form enquiries (your team inbox)
TEAM_EMAIL="your-email@gmail.com"
# Sender address visitors see (use onboarding@resend.dev for testing without
# a verified domain; once you own rohi.systems, change to hello@rohi.systems)
RESEND_FROM="ROHI SYSTEMS <onboarding@resend.dev>"
# The public site URL (used for the unsubscribe link in newsletter emails)
NEXT_PUBLIC_SITE_URL="https://rohi.systems"

# --- Rate limiting ---
# Set to "1" in production when behind a trusted reverse proxy (Caddy, nginx,
# Vercel) so per-IP rate limiting works. Without it, all visitors share one
# "unknown" rate-limit bucket (too restrictive, but not a security risk).
TRUST_PROXY="1"
