# ROHI SYSTEMS — environment variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Database (SQLite, local) ---
DATABASE_URL="file:./db/custom.db"

# --- AI Chatbot (OpenRouter) ---
# Get a FREE API key at https://openrouter.ai/keys (sign in with Google/GitHub)
# Free models are available — no payment needed.
OPENROUTER_API_KEY="sk-or-v1-your-key-here"
# Optional: override the model (defaults to nvidia/nemotron-3.5-super-vl:free)
# Browse models at https://openrouter.ai/models (filter for "free")
# OPENROUTER_MODEL="nvidia/nemotron-3.5-super-vl:free"

# --- Email notifications (Resend) ---
# Get a free API key at https://resend.com (100 emails/day free)
RESEND_API_KEY=""
# The email address to receive team notifications (your email)
TEAM_EMAIL="your-email@example.com"
# Optional: the "from" address (on free tier without a verified domain, leave as default)
# RESEND_FROM="ROHI SYSTEMS <onboarding@resend.dev>"
